# No secrets are required for the built-in demo.
# Optional override for a writable experiment database:
# MODELSPHERE_DB_PATH=.local/modelsphere.db

# Optional AI Experiment Insights. Leave blank to use the local summary.
# Set the real key as an environment variable or in Streamlit secrets (.streamlit/secrets.toml, untracked), never in Git.
# OPENAI_API_KEY=
# Optional model override (default is a low-cost model):
# OPENAI_MODEL=
